# Generated CMake / Ninja state, including builds outside a build directory.
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json
build.ninja
rules.ninja
.ninja_deps
.ninja_log
build*.log

# Generated ESP-IDF backups; sdkconfig and sdkconfig.defaults remain versioned.
sdkconfig.old

# Python test caches and compiler coverage/profiling output.
__pycache__/
*.py[cod]
.pytest_cache/
*.gcda
*.gcno
*.gcov
*.profraw
*.profdata
