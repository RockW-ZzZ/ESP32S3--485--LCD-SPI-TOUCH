# Build directories at any depth (ESP-IDF, host tests, CMake and PlatformIO).
build/
build-*/
build_*/
cmake-build-*/
.pio/

# Firmware images, object files, libraries and host test executables.
*.bin
*.elf
*.hex
*.uf2
*.axf
*.o
*.obj
*.a
*.lib
*.dll
*.exe
*.so
*.so.*
*.dylib
*.map
*.lst
*.sym
*.d
*.dep
*.su
*.exp
*.pdb
